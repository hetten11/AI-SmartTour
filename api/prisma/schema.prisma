generator client {
  provider        = "prisma-client"
  output          = "../src/generated/prisma"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider = "postgresql"
  extensions = [vector]
}

enum UserRole {
  traveler
  admin

  @@map("user_role")
}

enum Gender {
  male
  female
  other

  @@map("gender")
}

enum ItineraryStatus {
  draft
  active
  completed
  cancelled

  @@map("itinerary_status")
}

enum ItemType {
  place
  restaurant
  activity
  event
  transport
  rest

  @@map("item_type")
}

enum SyncStatus {
  running
  success
  failed

  @@map("sync_status")
}

enum ChangeType {
  created
  updated
  cancelled
  deleted

  @@map("change_type")
}

enum NotificationType {
  event_change
  weather
  reminder
  system

  @@map("notification_type")
}

enum ChunkSource {
  place
  event
  article
  policy

  @@map("chunk_source")
}

model User {
  id              String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email           String            @unique @db.VarChar(255)
  passwordHash    String?           @map("password_hash") @db.VarChar(255)
  fullName        String?           @map("full_name") @db.VarChar(150)
  avatarUrl       String            @map("avatar_url")
  role            UserRole          @default(traveler)
  isActive        Boolean           @default(true) @map("is_active")
  deletedAt       DateTime?         @map("deleted_at") @db.Timestamptz(6)
  createdAt       DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime          @default(now()) @map("updated_at") @db.Timestamptz(6)
  travelerProfiles TravelerProfile[]
  trips           Trip[]
  notifications   Notification[]
  chatMessages    ChatMessage[]
  chatSessions    ChatSession[]
  sessions        Session[]

  @@index([email])
  @@index([role])
  @@map("users")
}

model Session {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String   @map("user_id") @db.Uuid
  tokenHash        String   @unique @map("token_hash") @db.VarChar(64)
  refreshTokenHash String   @unique @map("refresh_token_hash") @db.VarChar(64)
  userAgent        String?  @map("user_agent") @db.VarChar(255)
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(6)
  refreshExpiresAt DateTime @map("refresh_expires_at") @db.Timestamptz(6)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  lastSeenAt       DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@index([refreshExpiresAt])
  @@map("sessions")
}

model TravelerProfile {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  nationality String?  @db.VarChar(2)
  language    String?  @default("vi") @db.VarChar(10)
  originCity  String?  @map("origin_city") @db.VarChar(100)
  budgetMin   Decimal? @map("budget_min") @db.Decimal(12, 2)
  budgetMax   Decimal? @map("budget_max") @db.Decimal(12, 2)
  currency    String?  @default("VND") @db.VarChar(3)
  travelStyle String?  @map("travel_style") @db.VarChar(50)
  interests   String[] @db.Text
  dislikes    String[] @db.Text
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trips       Trip[]

  @@index([userId])
  @@map("traveler_profiles")
}

model Trip {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String          @map("user_id") @db.Uuid
  profileId    String?         @map("profile_id") @db.Uuid
  title        String?         @db.VarChar(150)
  startDate    DateTime        @map("start_date") @db.Date
  endDate      DateTime        @map("end_date") @db.Date
  adults       Int             @default(1)
  children     Int             @default(0)
  notes        String?         @db.Text
  createdAt    DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  user         User            @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  profile      TravelerProfile? @relation(fields: [profileId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  companions   TripCompanion[]
  itineraries  Itinerary[]
  notifications Notification[]
  chatSessions ChatSession[]

  @@index([userId])
  @@index([startDate, endDate])
  @@map("trips")
}

model TripCompanion {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId    String   @map("trip_id") @db.Uuid
  name      String?  @db.VarChar(150)
  age       Int?
  gender    Gender?
  notes     String?  @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  trip      Trip     @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([tripId])
  @@map("trip_companions")
}

model Place {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String           @db.VarChar(200)
  slug           String?          @unique @db.VarChar(200)
  category       String           @db.VarChar(50)
  description    String?          @db.Text
  address        String?          @db.VarChar(255)
  district       String?          @db.VarChar(100)
  latitude       Decimal?         @db.Decimal(10, 7)
  longitude      Decimal?         @db.Decimal(10, 7)
  priceLevel     Int?             @map("price_level") @db.SmallInt
  avgRating      Decimal?         @map("avg_rating") @db.Decimal(2, 1)
  openingHours   Json?            @map("opening_hours") @db.JsonB
  tags           String[]         @db.Text
  isActive       Boolean          @default(true) @map("is_active")
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  itineraryItems ItineraryItem[]
  knowledgeChunks KnowledgeChunk[]

  @@index([category])
  @@index([district])
  @@index([latitude, longitude])
  @@index([tags])
  @@map("places")
}

model DataSource {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name           String    @db.VarChar(150)
  url            String    @unique @db.Text
  sourceType     String?   @default("api") @map("source_type") @db.VarChar(30)
  cronExpression String    @default("0 */6 * * *") @map("cron_expression") @db.VarChar(50)
  isActive       Boolean   @default(true) @map("is_active")
  lastSyncedAt   DateTime? @map("last_synced_at") @db.Timestamptz(6)
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  events         Event[]
  syncRuns       SyncRun[]

  @@map("data_sources")
}

model Event {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId        String?          @map("source_id") @db.Uuid
  externalId      String?          @map("external_id") @db.VarChar(255)
  title           String           @db.VarChar(255)
  description     String?          @db.Text
  venue           String?          @db.VarChar(255)
  address         String?          @db.VarChar(255)
  latitude        Decimal?         @db.Decimal(10, 7)
  longitude       Decimal?         @db.Decimal(10, 7)
  startAt         DateTime         @map("start_at") @db.Timestamptz(6)
  endAt           DateTime?        @map("end_at") @db.Timestamptz(6)
  isFree          Boolean?         @map("is_free")
  priceMin        Decimal?         @map("price_min") @db.Decimal(12, 2)
  priceMax        Decimal?         @map("price_max") @db.Decimal(12, 2)
  ticketUrl       String?          @map("ticket_url") @db.Text
  tags            String[]         @db.Text
  currentVersion  Int              @default(1) @map("current_version")
  isActive        Boolean          @default(true) @map("is_active")
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @default(now()) @map("updated_at") @db.Timestamptz(6)
  source          DataSource?      @relation(fields: [sourceId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  versions        EventVersion[]
  itineraryItems  ItineraryItem[]
  knowledgeChunks KnowledgeChunk[]

  @@unique([sourceId, externalId])
  @@index([startAt])
  @@index([latitude, longitude])
  @@index([tags])
  @@map("events")
}

model EventVersion {
  id             String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventId        String             @map("event_id") @db.Uuid
  versionNumber  Int                @map("version_number")
  changeType     ChangeType         @map("change_type")
  snapshot       Json               @db.JsonB
  changedFields  String[]           @map("changed_fields") @db.Text
  detectedAt     DateTime           @default(now()) @map("detected_at") @db.Timestamptz(6)
  event          Event              @relation(fields: [eventId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  impactDetections ImpactDetection[]

  @@unique([eventId, versionNumber])
  @@index([detectedAt])
  @@map("event_versions")
}

model SyncRun {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId     String     @map("source_id") @db.Uuid
  status       SyncStatus @default(running)
  itemsFetched Int        @default(0) @map("items_fetched")
  itemsCreated Int        @default(0) @map("items_created")
  itemsUpdated Int        @default(0) @map("items_updated")
  itemsDeleted Int        @default(0) @map("items_deleted")
  errorMessage String?    @map("error_message") @db.Text
  startedAt    DateTime   @default(now()) @map("started_at") @db.Timestamptz(6)
  finishedAt   DateTime?  @map("finished_at") @db.Timestamptz(6)
  source       DataSource @relation(fields: [sourceId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sourceId])
  @@index([sourceId, startedAt])
  @@map("sync_runs")
}

model Itinerary {
  id                 String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tripId             String          @map("trip_id") @db.Uuid
  parentItineraryId  String?         @map("parent_itinerary_id") @db.Uuid
  chatSessionId      String?         @map("chat_session_id") @db.Uuid
  title              String?         @db.VarChar(200)
  status             ItineraryStatus @default(draft)
  version            Int             @default(1)
  reason             String?         @db.Text
  generatedBy        String?         @default("ai") @map("generated_by") @db.VarChar(30)
  totalEstimatedCost Decimal?        @map("total_estimated_cost") @db.Decimal(12, 2)
  createdAt          DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime        @default(now()) @map("updated_at") @db.Timestamptz(6)
  trip               Trip            @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  parentItinerary    Itinerary?      @relation("ItineraryParent", fields: [parentItineraryId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  childItineraries   Itinerary[]     @relation("ItineraryParent")
  chatSession        ChatSession?    @relation(fields: [chatSessionId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  items              ItineraryItem[]
  impactDetections   ImpactDetection[]

  @@unique([tripId, version])
  @@index([tripId])
  @@index([parentItineraryId])
  @@index([chatSessionId])
  @@map("itineraries")
}

model ItineraryItem {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  itineraryId   String            @map("itinerary_id") @db.Uuid
  dayNumber     Int               @map("day_number")
  orderIndex    Int               @map("order_index")
  itemType      ItemType          @map("item_type")
  placeId       String?           @map("place_id") @db.Uuid
  eventId       String?           @map("event_id") @db.Uuid
  title         String            @db.VarChar(255)
  startTime     DateTime?         @map("start_time") @db.Timestamptz(6)
  endTime       DateTime?         @map("end_time") @db.Timestamptz(6)
  estimatedCost Decimal?          @map("estimated_cost") @db.Decimal(12, 2)
  notes         String?           @db.Text
  createdAt     DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  itinerary     Itinerary         @relation(fields: [itineraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  place         Place?            @relation(fields: [placeId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  event         Event?            @relation(fields: [eventId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  impactDetections ImpactDetection[]

  @@unique([itineraryId, dayNumber, orderIndex])
  @@index([itineraryId])
  @@index([placeId])
  @@index([eventId])
  @@map("itinerary_items")
}

model ImpactDetection {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  eventVersionId   String         @map("event_version_id") @db.Uuid
  itineraryId      String         @map("itinerary_id") @db.Uuid
  itineraryItemId  String?        @map("itinerary_item_id") @db.Uuid
  severity         Int            @default(1) @db.SmallInt
  description      String?        @db.Text
  isResolved       Boolean        @default(false) @map("is_resolved")
  detectedAt       DateTime       @default(now()) @map("detected_at") @db.Timestamptz(6)
  eventVersion     EventVersion   @relation(fields: [eventVersionId], references: [id], onDelete: NoAction, onUpdate: Cascade)
  itinerary        Itinerary      @relation(fields: [itineraryId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  itineraryItem    ItineraryItem? @relation(fields: [itineraryItemId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  notifications    Notification[]

  @@index([itineraryId])
  @@index([eventVersionId])
  @@map("impact_detections")
}

model Notification {
  id        String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  tripId    String?          @map("trip_id") @db.Uuid
  impactId  String?          @map("impact_id") @db.Uuid
  type      NotificationType
  title     String           @db.VarChar(200)
  body      String?          @db.Text
  isRead    Boolean          @default(false) @map("is_read")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trip      Trip?            @relation(fields: [tripId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  impact    ImpactDetection? @relation(fields: [impactId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, isRead])
  @@index([createdAt])
  @@map("notifications")
}

model KnowledgeChunk {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceType ChunkSource @map("source_type")
  placeId    String?   @map("place_id") @db.Uuid
  eventId    String?   @map("event_id") @db.Uuid
  title      String?   @db.VarChar(255)
  content    String    @db.Text
  embedding  Unsupported("vector(1536)")?
  metadata   Json?     @db.JsonB
  isActive   Boolean   @default(true) @map("is_active")
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime  @default(now()) @map("updated_at") @db.Timestamptz(6)
  place      Place?    @relation(fields: [placeId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  event      Event?    @relation(fields: [eventId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sourceType])
  @@index([placeId])
  @@index([eventId])
  @@map("knowledge_chunks")
}

model ChatSession {
  id            String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String        @map("user_id") @db.Uuid
  tripId        String?       @map("trip_id") @db.Uuid
  title         String?       @db.VarChar(150)
  lastMessageAt DateTime      @default(now()) @map("last_message_at") @db.Timestamptz(6)
  createdAt     DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  trip          Trip?         @relation(fields: [tripId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  messages      ChatMessage[]
  itineraries   Itinerary[]

  @@index([userId, lastMessageAt])
  @@index([tripId])
  @@map("chat_sessions")
}

model ChatMessage {
  id        String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String      @map("user_id") @db.Uuid
  sessionId String      @map("session_id") @db.Uuid
  role      String      @db.VarChar(20)
  content   String      @db.Text
  toolCalls Json?       @map("tool_calls") @db.JsonB
  createdAt DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  session   ChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  @@index([sessionId, createdAt])
  @@map("chat_messages")
}
